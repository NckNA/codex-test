PORT=4000
FRONTEND_URL=http://localhost:5173

# Server-only Supabase configuration. Never prefix service-role values with VITE_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# amoCRM OAuth application configuration.
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=http://localhost:4000/api/integrations/amocrm/callback
AMOCRM_AUTHORIZE_URL=https://www.amocrm.ru/oauth
AMOCRM_ALLOWED_ACCOUNT_DOMAIN=

# Optional local deterministic amoCRM mock base URL. Leave empty outside local QA.
AMOCRM_PROVIDER_BASE_URL=
AMOCRM_REQUEST_TIMEOUT_MS=10000
AMOCRM_OAUTH_STATE_TTL_SECONDS=600

# 32 random bytes encoded as base64 or 64 hex characters. Server-only.
AMOCRM_CREDENTIAL_ENCRYPTION_KEY=
AMOCRM_CREDENTIAL_KEY_VERSION=1
